// MERIDIAN Data Analyst Template - Prisma Schema
// Synthetic data platform for capital markets analytics

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Core market data
// ──────────────────────────────────────────────────────────────

model Venue {
  id          String   @id @default(cuid())
  code        String   @unique          // CME, NASDAQ, LSE, EUREX, TSE
  name        String
  region      String                    // us-east, eu-west, ap-southeast
  timezone    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ticks       Tick[]
  ohlcvBars   OhlcvBar[]
}

model Symbol {
  id          String   @id @default(cuid())
  ticker      String   @unique
  name        String
  assetClass  String                    // equity, fx, rate, commodity, option
  currency    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ticks       Tick[]
  ohlcvBars   OhlcvBar[]
  featureRows FeatureRow[]
  predictions Prediction[]
}

model Tick {
  id          String   @id @default(cuid())
  venueId     String
  symbolId    String
  ts          DateTime                 // exchange timestamp (microsecond precision stored as DateTime ms)
  price       Float
  size        Float
  side        String                    // bid, ask, trade
  feedLagMs   Float                     // ingestion lag in ms
  createdAt   DateTime @default(now())

  venue       Venue   @relation(fields: [venueId], references: [id])
  symbol      Symbol  @relation(fields: [symbolId], references: [id])

  @@index([symbolId, ts])
  @@index([venueId, ts])
}

model OhlcvBar {
  id          String   @id @default(cuid())
  symbolId    String
  venueId     String
  ts          DateTime
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float
  timeframe   String                    // 1s, 10s, 1m, 5m, 1h, 1d
  createdAt   DateTime @default(now())

  symbol      Symbol  @relation(fields: [symbolId], references: [id])
  venue      Venue   @relation(fields: [venueId], references: [id])

  @@index([symbolId, timeframe, ts])
}

// ──────────────────────────────────────────────────────────────
// Platform / Pipeline metadata
// ──────────────────────────────────────────────────────────────

model Pipeline {
  id            String   @id @default(cuid())
  name          String                     // Normalize, Enrich, Aggregate, AnomalyScore
  stage         String                     // L1 Ingestion, L3 Processing, etc.
  description   String
  status        String                     // running, degraded, stopped
  parallelism   Int
  throughputMps Float                      // msgs per second
  lagMs         Float                      // current lag
  p99LatencyMs  Float
  checkpointMs  Float                      // checkpoint duration
  lastRestart   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  incidents     Incident[]
}

model Dataset {
  id            String   @id @default(cuid())
  name          String                     // ticks.normalized, ohlcv.1m, etc.
  namespace     String                     // equities, fx, rates
  description   String
  format        String                     // iceberg, parquet, csv
  rowCount      Float
  sizeBytes     Float
  partitionKeys String                     // "day,symbol_bucket"
  schemaJson    String                     // JSON-encoded schema
  tier          String                     // hot, warm, cold, archive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  queries       SavedQuery[]
}

model SavedQuery {
  id            String   @id @default(cuid())
  name          String
  sqlText       String
  description   String?
  datasetId     String?
  createdBy     String
  lastRunMs      Int?
  lastRunRows   Int?
  executionCount Int     @default(0)
  isStarred     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataset       Dataset? @relation(fields: [datasetId], references: [id])
}

// ──────────────────────────────────────────────────────────────
// ML / Features
// ──────────────────────────────────────────────────────────────

model MlModel {
  id              String   @id @default(cuid())
  name            String                     // spoofing-detector-v3
  version         String
  type            String                     // classifier, regressor
  framework       String                     // lightgbm, onnx, pytorch
  status          String                     // production, shadow, retired
  accuracy        Float?
  p99InferenceMs  Float
  driftScore      Float
  deployedAt      DateTime
  retiredAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  predictions     Prediction[]
}

model FeatureRow {
  id            String   @id @default(cuid())
  symbolId       String
  featureName    String                     // rolling_trade_volume_1s, etc.
  value          Float
  ts             DateTime
  onlineStore    String                     // dynamodb, redis
  createdAt      DateTime @default(now())

  symbol         Symbol @relation(fields: [symbolId], references: [id])

  @@index([symbolId, featureName, ts])
}

model Prediction {
  id            String   @id @default(cuid())
  modelId       String
  symbolId      String?
  ts            DateTime
  score         Float
  label         String                     // spoofing, latency_arb, normal
  confidence    Float
  featuresJson  String                     // JSON-encoded feature snapshot
  createdAt     DateTime @default(now())

  model         MlModel @relation(fields: [modelId], references: [id])
  symbol        Symbol? @relation(fields: [symbolId], references: [id])
}

// ──────────────────────────────────────────────────────────────
// Governance / SLO / Alerts / Incidents
// ──────────────────────────────────────────────────────────────

model Slo {
  id              String   @id @default(cuid())
  name            String                     // tier-1-realtime-risk
  tier            String                     // tier-1, tier-2, tier-3
  availabilityPct Float
  p99LatencyMs    Float
  errorBudgetMin  Float
  budgetConsumedPct Float                    // 0-100
  burnRate1h      Float
  burnRate6h      Float
  burnRate24h     Float
  updatedAt       DateTime @updatedAt
}

model Alert {
  id            String   @id @default(cuid())
  severity      String                     // critical, warning, info
  source        String                     // flink, kafka, iceberg, slo
  title         String
  description   String
  status        String                     // firing, acked, resolved
  tier          String
  ackedBy       String?
  ackedAt       DateTime?
  firedAt       DateTime
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
}

model Incident {
  id            String   @id @default(cuid())
  title         String
  severity      String                     // sev1, sev2, sev3
  status        String                     // open, mitigated, resolved
  pipelineId    String?
  startedAt     DateTime
  detectedAt    DateTime
  resolvedAt    DateTime?
  durationMin   Int?
  rootCause     String?
  actionItems   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pipeline      Pipeline? @relation(fields: [pipelineId], references: [id])
}

model LineageEdge {
  id            String   @id @default(cuid())
  sourceType    String                     // kafka_topic, flink_job, iceberg_table
  sourceName    String
  targetType    String
  targetName    String
  relation      String                     // produces, consumes, transforms
  createdAt     DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  actor         String                     // user, service
  action        String                     // read, write, query, deploy
  resource      String
  resourceType  String                     // dataset, model, pipeline
  tier          String
  result        String                     // allow, deny
  ts            DateTime
  createdAt     DateTime @default(now())

  @@index([ts])
}
